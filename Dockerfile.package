# syntax=docker/dockerfile:1
# =============================================================================
# @hasna/mementos runtime image built from the PUBLISHED npm tarball.
# Used by the CodeBuild image-builder (npm pack -> docker build -f Dockerfile.package).
# The tarball ships prebuilt dist/, so no source build happens here.
# =============================================================================
FROM --platform=linux/arm64 oven/bun:1
WORKDIR /app
ENV NODE_ENV=production \
    HASNA_MEMENTOS_STORAGE_MODE=cloud \
    MEMENTOS_HOST=0.0.0.0 \
    PORT=8080

# Production deps only (pg, @hasna/contracts, ai sdk, tesseract.js, ...).
# --ignore-scripts: the tarball ships prebuilt dist/ (no src/), so the package's
# own prepare/build lifecycle must not run here.
COPY package.json bun.lock ./
RUN bun install --production --frozen-lockfile --ignore-scripts

# Prebuilt bundles shipped in the tarball.
COPY dist ./dist

# Entrypoint (also shipped in the tarball).
COPY docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD bun -e "fetch('http://127.0.0.1:'+(process.env.PORT||8080)+'/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
CMD ["mementos-serve"]
